# Copy the names below into Vercel → Project → Settings → Environment Variables.
# Never commit real keys. Never paste them in a chat.

# Database (Supabase → Project Settings → API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# AI for scripts, prompts and review (Anthropic Console). Optional: CLAUDE_MODEL to override the default model.
ANTHROPIC_API_KEY=
# Grok (xAI) for the owner's agent office (Panel → Oficina). Optional: models default to grok-4.3 / grok-4.7.
XAI_API_KEY=
XAI_MODEL=
XAI_MODEL_CEO=

# Video and images: Veo 3.1 + Nano Banana Pro (Google AI Studio)
GEMINI_API_KEY=

# Video: Seedance, Kling and others (fal.ai)
FAL_KEY=
# Comfy Router (api.comfy.org): Higgsfield Genjutsu for «Mi personaje · Máxima calidad». Make the key inside a Comfy *workspace*.
COMFY_API_KEY=
# Optional: what Genjutsu costs per second at 720p (US$), default 0.35
NEXT_PUBLIC_GENJUTSU_USD_PER_SEC=

# Voices (ElevenLabs)
ELEVENLABS_API_KEY=

# Winning-ad research (Foreplay)
FOREPLAY_API_KEY=


# Asked once, on the very first visit to /app, to create the owner's account (email + password).
ADMIN_ACCESS_CODE=

# Payments (Mercado Pago, Chile). TEST- token first, then the production one (APP_USR-).
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# 1 = monthly plans are charged once (no automatic renewal), e.g. while using a temporary account
MP_ONE_TIME=
# Public address used in payment return links (default https://www.creadsia.com)
SITE_URL=

# Meta: server-side conversions (API de conversiones). The pixel id has a default.
META_CAPI_TOKEN=
NEXT_PUBLIC_META_PIXEL_ID=

# Owner recovery code: use a long random value (32+ characters)

# Emails (Resend → API Keys). The domain creadsia.com must be verified in Resend (Domains).
RESEND_API_KEY=
# Optional sender, default "Creads IA <hola@creadsia.com>"
EMAIL_FROM=
# Daily plan reminders: a long random value (Vercel sends it to the scheduled job)
CRON_SECRET=

# WhatsApp for customer help (country code + number, e.g. 56912345678). Empty = no button.
NEXT_PUBLIC_WHATSAPP=

# Marketing studio (Panel → Marketing): Meta system-user token, ad account (act_…), page, optional Instagram
# account for ads, and for comment auto-replies the app secret + a webhook verify token (16+ chars).
META_ADS_TOKEN=
META_AD_ACCOUNT_ID=
META_PAGE_ID=
META_IG_USER_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
# Assignments for Claude as GitHub issues (fine-grained token: Issues read/write on this repo only)
GITHUB_ENCARGOS_TOKEN=
