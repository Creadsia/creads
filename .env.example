# Copy the names below into Vercel → Project → Settings → Environment Variables.
# Never commit real keys. Never paste them in a chat.

# Database (Supabase → Project Settings → API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# AI for scripts, prompts and review (Anthropic Console). Optional: CLAUDE_MODEL to override the default model.
ANTHROPIC_API_KEY=

# Video and images: Veo 3.1 + Nano Banana Pro (Google AI Studio)
GEMINI_API_KEY=

# Video: Seedance, Kling and others (fal.ai)
FAL_KEY=

# Voices (ElevenLabs)
ELEVENLABS_API_KEY=

# Winning-ad research (Foreplay)
FOREPLAY_API_KEY=

# Temporary access code for /estudio until login exists (Phase 2)
CREADS_ACCESS_CODE=

# Owner-only internal panel at /admin (long code only the owner knows; different from CREADS_ACCESS_CODE)
ADMIN_ACCESS_CODE=
